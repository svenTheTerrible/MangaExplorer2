<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             tools:context=".FavoritenListItem" android:clickable="true"
             android:id="@+id/resultContainer">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent" android:touchscreenBlocksFocus="true"
                android:baselineAligned="false" android:gravity="center_vertical" android:clickable="false"
                android:focusable="auto">
            <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp" tools:src="@tools:sample/avatars[3]"
                    android:id="@+id/searchResultImage"
                    android:clickable="false"/>
            <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:clickable="false">
                <TextView
                        android:text="Manga Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:id="@+id/mangaTitle"
                        android:paddingLeft="15dp" android:textSize="18sp" android:textStyle="bold"
                        android:clickable="false"/>
            </LinearLayout>
        </LinearLayout>
        <View
                android:id="@+id/listDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:clickable="false" android:elevation="0dp"/>
    </LinearLayout>

</FrameLayout>