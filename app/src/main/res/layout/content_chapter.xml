<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:showIn="@layout/activity_chapter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Activities.ChapterActivity">
    <android.support.v7.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="10dp" android:id="@+id/chapterRecyclerView"
            tools:listitem="@layout/chapter_result_list_item" android:background="@color/greyBackground"/>
</android.support.v4.widget.NestedScrollView>