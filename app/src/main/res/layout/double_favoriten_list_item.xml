<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        tools:context=".FavoritenListItem">

    <!-- TODO: Update blank fragment layout -->

    <android.support.v7.widget.CardView
            android:id="@+id/leftFavoriteCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:clickable="false"
                android:focusable="auto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:touchscreenBlocksFocus="true">

            <ImageView
                    android:id="@+id/leftCoverImageView"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:clickable="false"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/avatars[3]" />

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:orientation="vertical">

                <TextView
                        android:id="@+id/leftTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:paddingLeft="15dp"
                        android:text="Manga Title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/leftSourceTextView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:paddingLeft="15dp"
                        android:text="Manga Source" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:gravity="right"
                    android:orientation="vertical">

                <FrameLayout
                        android:id="@+id/leftUpdateAvailableFrameLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/design_default_color_primary"
                        android:clickable="false"
                        android:padding="5dp">

                    <TextView
                            android:id="@+id/leftUpdateAvailableTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text="new"
                            android:textColor="@color/white" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

    </android.support.v7.widget.CardView>

    <android.support.v7.widget.CardView
            android:id="@+id/rightFavoriteCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:clickable="false"
                android:focusable="auto"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:touchscreenBlocksFocus="true">

            <ImageView
                    android:id="@+id/rightCoverImageView"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:clickable="false"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/avatars[3]" />

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:orientation="vertical">

                <TextView
                        android:id="@+id/rightTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:paddingLeft="15dp"
                        android:text="Manga Title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/rightSourceTextView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:paddingLeft="15dp"
                        android:text="Manga Source" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:gravity="right"
                    android:orientation="vertical">

                <FrameLayout
                        android:id="@+id/rightUpdateAvailableFrameLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/design_default_color_primary"
                        android:clickable="false"
                        android:padding="5dp">

                    <TextView
                            android:id="@+id/rightUpdateAvailableTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text="new"
                            android:textColor="@color/white" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

    </android.support.v7.widget.CardView>

</LinearLayout>